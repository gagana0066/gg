generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// enable pgvector extension in migrations
// run: CREATE EXTENSION IF NOT EXISTS pgvector;

model User {
  id            String        @id @default(uuid())
  email         String        @unique
  name          String?
  goals         Goal[]
  habits        Habit[]
  journal       JournalEntry[]
  weeklyScores  WeeklyScore[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model Goal {
  id        String   @id @default(uuid())
  title     String
  category  String
  deadline  DateTime?
  progress  Int      @default(0)
  status    String   @default("active")
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Habit {
  id        String      @id @default(uuid())
  name      String
  user      User        @relation(fields: [userId], references: [id])
  userId    String
  logs      HabitLog[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model HabitLog {
  id        String   @id @default(uuid())
  date      DateTime
  completed Boolean  @default(false)
  habit     Habit    @relation(fields: [habitId], references: [id])
  habitId   String
  createdAt DateTime @default(now())
}

model JournalEntry {
  id        String   @id @default(uuid())
  date      DateTime @default(now())
  mood      Int      // 1-5
  text      String
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())
}

model WeeklyScore {
  id          String   @id @default(uuid())
  weekStart   DateTime
  discipline  Int
  growth      Int
  health      Int
  output      Int
  user        User     @relation(fields: [userId], references: [id])
  userId      String
  createdAt   DateTime @default(now())
}
